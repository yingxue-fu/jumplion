/research_jude/rgs01_jude/dept/PRTEO/repository/pi/Chengrp/Chengrp_051325_061225_CP/BrukerHT/CellPellets/Chengrp_051325_cpDIA_S2_S3-A5_1_922.d
/research_jude/rgs01_jude/dept/PRTEO/repository/pi/Chengrp/Chengrp_051325_061225_CP/BrukerHT/CellPellets/Chengrp_051325_cpDIA_S3_S3-A9_1_926.d
/research_jude/rgs01_jude/dept/PRTEO/repository/pi/Chengrp/Chengrp_051325_061225_CP/BrukerHT/CellPellets/Chengrp_051325_cpDIA_S4_S3-B1_1_930.d

# Precursor-level idetification report
id_report = /research/rgs01/home/clusterHome/sbyrum/projects/02_Chengrp_0513_061225_auto/data/search_results_20250626/report.parquet

# Spectral library (support .tsv/.csv/.parquet format)
spec_lib = /research/rgs01/home/clusterHome/sbyrum/projects/02_Chengrp_0513_061225_auto/data/search_results_20250626/report-lib.parquet

# Fasta files
fastas = /home/sbyrum/projects/Chengrp_052325/db/HUMAN_6_sp_tr_uc_snp_con_cu.fasta

# Output directory name
out_dir = chengrp_20250701


[optional]
# General settings
log_level = 5                      # Level of log messages
use_saved_rts = 0                  # Use existing precursor RTs (and IMs), 0 = false, 1 = true
use_saved_xic = 0                  # Use existing XIC files, 0 = false, 1 = true
use_xic_report = 0                 # Use existing XIC quant report file, 0 = false, 1 = true

# ID results processing
min_runs_quant = 1                 # Minimum number of runs a precursor must be identified in to be quantified
min_runs_model = 2                 # Minimum number of runs a precursor must be identified in to be used for building RT/IM prediction model
min_runs_cal = 3                   # Minimum number of runs a precursor must be identified in to be used for mass calibration
min_qvalue_cal = 0.0001            # Minimum Q-value (FDR) for a precursor to be used for mass calibration
max_mass_cal = 5000                # Maximum number of precursors used for mass calibration

# Mass calibration
mass_calibration = 1               # Whether to perform mass calibration, 0 = false, 1 = true
mass_cal_acc = 30.0                # Calibration mass accuracy (ppm)
mass_cal_bins = 1                  # Number of RT bins for mass calibration
mass_cal_bins_max = 1              # Maximum number of RT bins for mass calibration
fix_mass_acc = 0                   # Use fixed MS1/MS2 mass accuracy as defined below
mass_acc_ms2 = 15.0                # MS2 mass accuracy (ppm)
mass_acc_ms1 = 15.0                # MS1 mass accuracy (ppm)
individual_mass_acc = 0            # Determine MS1/MS2 mass accuracy for each individual run

# Ion mobility (IM) window
im_window_cal = 0.03               # IM window used for calibration
fix_im_window = 0                  # Use fixed IM window as defined below
im_window = 0.01                   # IM window
individual_im_window = 0           # Determine IM window for each individual run

# XIC extraction and scoring
min_quan_fr = 3                    # Minimum number of fragments for a precursor to be quantified
max_quan_fr = 6                    # Maximum number of fragments used for precursor quantification
n_isotops = 2                      # Number of isotopes of a precursor to extract
min_xic_points = 20                # Minimum number of points to extract for a XIC
corr_radius = 5                    # Number of points adjacent to the apex used for correlation calculation
corr_method = 0                    # Correlation calculation method, 0 = Pearson, 1 = Spearman
weight_by_shape = 1                # Weight the correlation by XIC shape, 0 = false, 1 = true 
weight_by_intensity = 1            # Weight the correlation by XIC intensity, 0 = false, 1 = true
min_shape_score = 0.3              # Minimum shape score for a XIC to be defined as the optimal XIC
min_xic_intensity = 10.0           # Minimum intensity for any data point of a XIC
min_apex_intensity = 30.0          # Minimum intensity for the apex point of a XIC
min_apex_evidence = 0.99           # Apex point should be higher than X% of highest neighbor points 
optimal_xic_source = 0             # MS level of the optimal XIC, 0 = MS1 or MS2, 1 = MS1 only, 2 = MS2 only

# Interference removal 
int_removal = 1                    # Interference removal for a XIC, 0 = off, 1 = on
int_removal_corr = 0.0             # Minimum correlation for a XIC to be subject to interference removal
int_filter_factor = 1.5            # Interference filtering factor

# Normalization
norm_species = HUMAN               # The species of peptides used for intensity normalization
norm_method = 0                    # Normalization method, 0 = median, 1 = mean
trim_percentage = 5                # Percentage trimmed on each side for normalization